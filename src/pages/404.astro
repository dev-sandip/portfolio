---
import BaseLayout from "../layouts/BaseLayout.astro"
 
const description = "Page not found — this URL doesn't exist on Sandip Sapkota's site."
---
 
<BaseLayout
	pageTitle="404 — Page Not Found"
	description={description}
	canonicalPath="/404"
>
	<div class="flex flex-col gap-y-8 grow items-start justify-center py-16">
		<p class="text-sm text-neutral-500 dark:text-neutral-400">404</p>
 
		<h1 class="text-2xl font-bold">This page doesn't exist</h1>
 
		<p class="max-w-md text-neutral-600 dark:text-neutral-400 leading-relaxed">
			The link might be broken, or the page may have moved. Let's get you
			back on track.
		</p>
 
		<blockquote class="border-l-2 border-blue-500 pl-4 italic text-neutral-700 dark:text-neutral-300">
			"Not all who wander are lost. This route, though, is."
		</blockquote>
 
		<a
			href="/"
			class="text-blue-600 dark:text-blue-400 hover:underline"
		>
			&larr; Back to home
		</a>
	</div>
</BaseLayout>
 