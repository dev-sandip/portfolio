<script>
  // Click or tap the signature to replay the write-on
  document.querySelectorAll<HTMLElement>(".signature").forEach((el) => {
    el.addEventListener("click", () => {
      const svg = el.querySelector<SVGElement>(".signature-svg")
      if (!svg) return
      svg.style.animation = "none"
      void svg.getBoundingClientRect()
      svg.style.animation = ""
    })
  })
</script>

